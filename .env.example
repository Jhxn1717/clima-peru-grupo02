# Configuración del Sistema Meteorológico del Perú - Clima Perú (Grupo 02)
# PostgreSQL remoto (Supabase) — reemplaza TU_REF, TU_REGION y TU_PASSWORD
DATABASE_URL=postgresql+psycopg2://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Para SQLite local (solo desarrollo):
# DATABASE_URL=sqlite:///./clima_peru.db
# Para PostgreSQL propio:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/clima_peru_db

CACHE_TTL_MINUTES=15
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_HISTORICAL_URL=https://archive-api.open-meteo.com/v1
CORS_ORIGINS=["*"]

# --- Autenticación (JWT) ---
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=pon-aqui-tu-clave-secreta
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
VERIFICATION_CODE_EXPIRE_MINUTES=15

# --- SMTP (Gmail) para verificación de correo ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-app-password
SMTP_FROM=tu-correo@gmail.com
