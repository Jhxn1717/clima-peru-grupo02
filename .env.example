# =============================================================
# SISTEMA METEOROLÓGICO DEL PERÚ — Clima Perú Grupo 02
# Copia este archivo como .env y completa los valores
# =============================================================

# --- Base de datos (Supabase PostgreSQL) ---
# Connection string del Transaction Pooler (puerto 6543)
# Encoda caracteres especiales en la contraseña: @ → %40, : → %3A
# Ejemplo con el proyecto del grupo:
DATABASE_URL=postgresql+psycopg2://postgres.emwdzhkurfdpicuuqbvb:TU_PASSWORD_ENCODED@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require

# Para desarrollo local con SQLite (sin Supabase):
# DATABASE_URL=sqlite:///./clima_peru.db

CACHE_TTL_MINUTES=15
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_HISTORICAL_URL=https://archive-api.open-meteo.com/v1
CORS_ORIGINS=["*"]

# --- Autenticación (JWT) ---
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=pon-aqui-tu-clave-secreta
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
VERIFICATION_CODE_EXPIRE_MINUTES=15

# --- SMTP Gmail para verificación de correo ---
# Requiere una App Password de Gmail (no la contraseña normal)
# Crear en: https://myaccount.google.com/apppasswords
# Si no se configura, el código de verificación se imprime en consola
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=tu-correo@gmail.com
