# ══════════════════════════════════════════════════════════════════════════════
# Sistema Meteorológico del Perú — Clima Perú (Grupo 02)
# Copia este archivo como .env y ajusta los valores para tu entorno.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./clima_peru.db
# Para PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/clima_peru_db

# ─── Caché y APIs meteorológicas ─────────────────────────────────────────────
CACHE_TTL_MINUTES=15
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_HISTORICAL_URL=https://archive-api.open-meteo.com/v1

# ─── CORS (en producción, especifica los orígenes exactos) ───────────────────
CORS_ORIGINS=["*"]
# Ejemplo producción: CORS_ORIGINS=["https://meteoperu.vercel.app"]

# ─── Autenticación JWT ────────────────────────────────────────────────────────
# ⚠  CAMBIA ESTA CLAVE EN PRODUCCIÓN — genera una con: openssl rand -hex 32
JWT_SECRET_KEY=clima-peru-super-secret-key-CHANGE-IN-PRODUCTION

# Tiempo de expiración del token de acceso (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# URL base del API para el frontend en producción
# VITE_API_URL=https://tu-backend.vercel.app/api

# ─── Credenciales del Super Administrador inicial (solo primer arranque) ──────
# Usuario: superadmin@meteoperu.com
# Contraseña: Admin1234!
# ⚠  Cambia la contraseña desde el Panel de Administración después del primer login.
